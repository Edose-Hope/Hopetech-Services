{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-site.mjs",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://training.hopetechservices.com.ng; connect-src 'self' https://formspree.io https://training.hopetechservices.com.ng; frame-src https://www.google.com; frame-ancestors 'self' https://training.hopetechservices.com.ng; object-src 'none'; base-uri 'self'; form-action 'self' https://formspree.io"
      },
      "continue": true
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "solar.hopetechservices.com.ng"
        }
      ],
      "headers": {
        "Location": "https://energy.hopetechservices.com.ng/$1"
      },
      "status": 308
    },
    {
      "src": "^/(about|services-full|thanks)(?:\\.html)?/?$",
      "has": [
        {
          "type": "host",
          "value": "hopetechservices.com.ng"
        }
      ],
      "headers": {
        "Location": "https://energy.hopetechservices.com.ng/$1"
      },
      "status": 308
    },
    {
      "src": "^/solar(?:/(.*))?$",
      "has": [
        {
          "type": "host",
          "value": "hopetechservices.com.ng"
        }
      ],
      "headers": {
        "Location": "https://energy.hopetechservices.com.ng/$1"
      },
      "status": 308
    },
    {
      "src": "^/admin(?:\\.html)?/?$",
      "has": [
        {
          "type": "host",
          "value": "energy.hopetechservices.com.ng"
        }
      ],
      "headers": {
        "Location": "https://training.hopetechservices.com.ng/admin",
        "X-Robots-Tag": "noindex, nofollow, noarchive",
        "Cache-Control": "no-store"
      },
      "status": 307
    },
    {
      "src": "^/(about|services-full|thanks)(?:\\.html|/)$",
      "has": [
        {
          "type": "host",
          "value": "energy.hopetechservices.com.ng"
        }
      ],
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "src": "^/index(?:\\.html)?/?$",
      "has": [
        {
          "type": "host",
          "value": "energy.hopetechservices.com.ng"
        }
      ],
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "^/(about|services-full|thanks)$",
      "has": [
        {
          "type": "host",
          "value": "energy.hopetechservices.com.ng"
        }
      ],
      "dest": "/solar/$1.html"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "energy.hopetechservices.com.ng"
        }
      ],
      "dest": "/solar/index.html"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "energy.hopetechservices.com.ng"
        }
      ],
      "dest": "/solar/$1"
    },
    {
      "src": "^/corporate(?:/index\\.html|/)?$",
      "headers": {
        "Location": "/"
      },
      "status": 307
    },
    {
      "src": "^/index(?:\\.html)?/?$",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "handle": "filesystem"
    }
  ]
}
